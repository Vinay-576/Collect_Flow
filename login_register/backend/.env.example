MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=collectflow
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
CREDITOR_DASHBOARD_PATH=/dashboard/creditor
AGENCY_DASHBOARD_PATH=/dashboard/agency
DEBTOR_PORTAL_PATH=/dashboard/debtor

# Outgoing debtor invitation email (use a mailbox app password, not your mailbox password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
FRONTEND_APP_URL=http://127.0.0.1:5173

# Google OAuth 2.0 Web application credentials.
# Register this callback as an authorized redirect URI:
# https://collectflow576.netlify.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
